{
  "manifest_version": 2,
  "name": "Polimath Filters",
  "version": "3.1.0",
  "description": "Powerful email filters with regex and arbitrary boolean conditions.",
  "author": "Stephen Haptonstahl",
  "browser_specific_settings": {
    "gecko": {
      "id": "polimath-filters@haptonstahl.org",
      "strict_min_version": "78.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "messagesRead",
    "messagesMove",
    "messagesDelete",
    "messagesUpdate",
    "accountsRead",
    "addressBooks",
    "storage"
  ],
  "background": {
    "scripts": ["confusables-data.js", "filter-engine.js", "background.js"]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
