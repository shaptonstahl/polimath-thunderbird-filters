# `npm version` bumps package.json (and, via the version lifecycle hook,
# manifest.json) and commits the result, but it must not create a tag: CI
# creates the `v<version>` tag and the GitHub release from it, so a tag made
# locally would duplicate — or worse, diverge from — the one that ships.
#
# One tagger, one place: push to main and let .github/workflows/ci.yml do it.
git-tag-version=false
